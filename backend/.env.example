# Copy to backend/.env and adjust. Every value has a working default.
AIS_ENVIRONMENT=local
AIS_DEBUG=false

# SQLite for the POC. A PostgreSQL DSN here needs no code change:
# AIS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ais
# AIS_DATABASE_URL=sqlite:///.../runtime/db/ais.db

# MLflow
AIS_MLFLOW_ENABLED=true

# Eligibility profile.
#   reference       - honour the reference projects' thresholds exactly.
#                     Six of thirteen models are then Ineligible at monthly
#                     grain (docs/DECISIONS.md D-001).
#   monthly_relaxed - documented deviation so all 13 can be compared.
AIS_MIN_HISTORY_PROFILE=reference

# XGBoost profile. thorough = Meriton's GridSearchCV; fast = Sodexo's fixed params.
AIS_XGBOOST_TRAINING_PROFILE=thorough

# Training budget (measured; docs/ARCHITECTURE.md section 6)
AIS_MAX_LOCAL_SERIES=500
AIS_PER_MODEL_TIMEOUT_SECONDS=120
AIS_LSTM_TIMEOUT_SECONDS=300
AIS_MAX_TRAINING_WORKERS=4

# Inventory assumptions
AIS_REVIEW_PERIOD_DAYS=30
AIS_DEFAULT_LEAD_TIME_DAYS=3

# --- AI assistant -------------------------------------------------------
# The assistant runs React -> this FastAPI backend -> OpenAI. The key stays
# server-side: it is never sent to the browser, never placed in a VITE_
# variable, never logged and never returned in a response.
#
# Leave OPENAI_API_KEY blank and the whole application still works normally -
# the assistant page then shows setup instructions instead of answering.
#
# Both spellings are accepted: these unprefixed names, or the project's own
# AIS_ convention (AIS_OPENAI_API_KEY=...).
OPENAI_API_KEY=
# gpt-4.1-mini: current, documented, supports tool calling, and cheap enough
# to run an assistant that only has to narrate facts the backend computed.
OPENAI_MODEL=gpt-4.1-mini
AI_ASSISTANT_ENABLED=true
# Sampling temperature for the assistant. 2.0 is OpenAI's maximum and it was
# tried: the assistant answered a question about monthly demand with a sentence
# mixing Korean, Hebrew, Tamil, Cyrillic and Arabic, and the drift explanation
# came back as four-script nonsense. A coherence guard now rejects that text on
# both paths, but a guard that fires often is a bad setting, not a safety net.
# 0.3 keeps the prose varied enough to read and grounded enough to trust.
AI_TEMPERATURE=0.3

# Explanations run cooler still - they restate computed figures and have no
# reason to improvise (docs/DECISIONS.md D-061).
AI_EXPLANATION_TEMPERATURE=0.3

AI_MAX_OUTPUT_TOKENS=900
AI_REQUEST_TIMEOUT_SECONDS=30

# --- Workspace scope -------------------------------------------------
# Restricts EVERY page and payload to these branches and SKUs. Leave both
# blank and the application is unrestricted - it then falls back to the
# active training run's restriction, and failing that reports the whole
# network.
#
# This is not a filter the user can clear from the UI: it is the slice the
# deployment reports on, stated on every response as `workspace_scope`
# (docs/DECISIONS.md D-049). A clone that leaves these blank will render
# every branch it has data for, which is correct but is not the POC.
#
# The values below are the POC's: two branches and the twenty SKUs chosen
# to span vehicle category, glass type, value class and vehicle age
# (D-075, D-081, D-082, D-083).
AIS_WORKSPACE_BRANCHES=BENGALURU,DELHI-1
AIS_WORKSPACE_SKUS=FG.BA5.LFH.GCG2120000,FG.HBI.LFH.GCG2120000,FG.HBR.LFH.GCG2120000,FG.HIR.LFH.GCG2120000,FG.KQY.LFH.GCG2120000,FG.MJ1.LFH.GCG2120000,FG.MP8.BCK.G00300A000,FG.MP8.FDR.G00300A000,FG.MP8.LFH.GCG2120000,FG.MP9.LFH.GCG21X0000,FG.MRL.BCK.G00Z00A100,FG.MTL.BCK.G00280A300,FG.MTV.LFH.GCG21X0000,FG.MW5.LFH.GCG2120000,FG.MW6.LFH.GAG21XAR00,FG.MY7.LFH.GCG2120000,FG.MYS.BCK.G00300A000,FG.MYS.LFH.GCG2120000,FG.T56.LFH.GXG21XAT00,FG.TCF.LFH.GCG2120000

# `reference` is each model's published minimum history. `monthly_relaxed`
# lowers it where the model tolerates a shorter window, which is what makes
# all 13 eligible on a 28-month panel. The POC runs relaxed.
# AIS_MIN_HISTORY_PROFILE=monthly_relaxed
